<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ZenkeiViewerXaml.ZenkeiViewerStyles">
    <Style Selector="Menu">
      <Setter Property="Background" Value="{DynamicResource ThemeControlMidBrush}" />
      <Setter Property="Opacity" Value="0.8"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseInOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.nav-button">
      <Setter Property="Padding" Value="13,0"/>
      <Setter Property="Opacity" Value="0.8"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseInOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector=".main-window:inactive Menu">
      <Setter Property="Opacity" Value="0.0"/>
    </Style>
    <Style Selector=".main-window:inactive Button.nav-button">
      <Setter Property="Opacity" Value="0.0"/>
    </Style>
</Styles>